generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id           Int               @id @default(autoincrement())
  fullName     String
  socialName   String            
  cpf          String            @unique
  birthDate    String
  phone        String?           
  sex          String?           
  race         String?           
  addresses    PatientAddress[]  
  attendances  Attendance[]
}

model PatientAddress {
  id           Int       @id @default(autoincrement())
  street       String
  number       String?
  complement   String?
  neighborhood String?
  city         String
  state        String
  zipCode      String
  isMain       Boolean   @default(true) 
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId    Int       
}

model Professional {
  id                Int                     @id @default(autoincrement())
  fullName          String
  cpf               String                  @unique
  profile           String
  password          String
  currentOffice     Int?       
  attendanceMode    String?
  phone             String?                 
  sex               String?                 
  addresses         ProfessionalAddress[]   
  attendances       Attendance[]
  attendanceHistory AttendanceHistory[]
}

model ProfessionalAddress {
  id               Int          @id @default(autoincrement())
  street           String
  number           String?
  complement       String?
  neighborhood     String?
  city             String
  state            String
  zipCode          String
  isMain           Boolean      @default(true)  
  professional     Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId   Int       
}

model Attendance {
  id              Int                  @id @default(autoincrement())
  patient         Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId       Int
  status          AttendanceStatus     @default(PENDING)
  stage           AttendanceStage
  createdAt       DateTime             @default(now())
  finishedAt      DateTime?
  professional    Professional?        @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  professionalId  Int?
  officeNumber    Int?
  history         AttendanceHistory[]
}

model AttendanceHistory {
  id              Int               @id @default(autoincrement())
  attendance      Attendance        @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  attendanceId    Int
  professional    Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId  Int
  fromStage       AttendanceStage?
  toStage         AttendanceStage
  status          AttendanceStatus
  timestamp       DateTime          @default(now())
  officeNumber    Int?
  note            String?
}

enum AttendanceStatus {
  PENDING
  IN_PROGRESS
  FINISHED
}

enum AttendanceStage {
  TRIAGE
  VACCINE
  MEDICAL_CONSULTATION
  NURSING_CONSULTATION
  DENTAL_CONSULTATION
}