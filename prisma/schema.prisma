generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id           Int               @id @default(autoincrement())
  fullName     String
  socialName   String            
  cpf          String            @unique
  birthDate    String
  phone        String?           
  sex          String?           
  race         String?           
  addresses    PatientAddress[]  
  attendances  Attendance[]
  healthUnitFlowAudit HealthUnitFlowAudit[]
}

model PatientAddress {
  id           Int       @id @default(autoincrement())
  street       String
  number       String?
  complement   String?
  neighborhood String?
  city         String
  state        String
  zipCode      String?
  isMain       Boolean   @default(true) 
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId    Int       
}

model Professional {
  id                Int                     @id @default(autoincrement())
  fullName          String
  cpf               String                  @unique
  profile           String
  password          String
  currentOffice     Int?       
  attendanceMode    String?
  phone             String?                 
  sex               String? 
  email             String?
  active            Boolean                 @default(true)
  healthUnit        HealthUnit[]        
  addresses         ProfessionalAddress[]   
  attendances       Attendance[]
  attendanceHistory AttendanceHistory[]
  healthUnitFlowAudit HealthUnitFlowAudit[]
}

model ProfessionalAddress {
  id               Int          @id @default(autoincrement())
  street           String
  number           String?
  complement       String?
  neighborhood     String?
  city             String
  state            String
  zipCode          String?
  isMain           Boolean      @default(true)  
  professional     Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId   Int       
}

model HealthUnit {
  id           Int       @id @default(autoincrement())
  name         String
  cnpj         String    @unique
  phone        String?
  addresses    HealthUnitAddress[]
  professionals Professional[]
  healthUnitFlowAudit HealthUnitFlowAudit[]
}

model HealthUnitAddress {
  id           Int          @id @default(autoincrement())
  street       String
  number       String?
  complement   String?
  neighborhood String?
  city         String
  state        String
  zipCode      String?
  isMain       Boolean      @default(true) 
  healthUnit   HealthUnit   @relation(fields: [healthUnitId], references: [id], onDelete: Cascade)
  healthUnitId Int       
}

model HealthUnitFlowAudit {
  id              Int           @id @default(autoincrement())
  healthUnit      HealthUnit    @relation(fields: [healthUnitId], references: [id], onDelete: Cascade)
  healthUnitId    Int
  flowAction      FlowAction
  ofTheAttendanceStage AttendanceStage?
  toTheAttendanceStage AttendanceStage?
  createdAt       DateTime      @default(now())
  professional    Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  professionalId  Int?
  patient         Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientId       Int?
}

model Attendance {
  id              Int                  @id @default(autoincrement())
  patient         Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId       Int
  status          AttendanceStatus     @default(PENDING)
  stage           AttendanceStage
  createdAt       DateTime             @default(now())
  finishedAt      DateTime?
  professional    Professional?        @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  professionalId  Int?
  officeNumber    Int?
  history         AttendanceHistory[]
}

model AttendanceHistory {
  id              Int               @id @default(autoincrement())
  attendance      Attendance        @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  attendanceId    Int
  professional    Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId  Int
  fromStage       AttendanceStage?
  toStage         AttendanceStage
  status          AttendanceStatus
  cid             Cid? @relation(fields: [cidid], references: [id])
  cidid Int?
  finishedAt      DateTime          @default(now())
  officeNumber    Int?
  note            String?
}

model Cid {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  description String
  AttendanceHistory AttendanceHistory[]
}

enum FlowAction {
  ATTENDANCE_GENERATED
  PATIENT_CALLED
  PATIENT_REFERRED
  ATTENDANCE_FINALIZED
}

enum AttendanceStatus {
  PENDING
  IN_PROGRESS
  FINISHED
}

enum AttendanceStage {
  TRIAGE
  VACCINE
  MEDICAL_CONSULTATION
  NURSING_CONSULTATION
  DENTAL_CONSULTATION
}